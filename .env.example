# Copy to .env. server.py will auto-generate CLAUDE_WEB_SECRET if .env is missing.

# Long random string. Used to mint the device cookie via /auth?secret=<value>.
CLAUDE_WEB_SECRET=

# Port the aiohttp server binds to (loopback only; tunnel exposes it externally).
CLAUDE_WEB_PORT=9000

# Default working directory (blank = $HOME). Per-request cwd must resolve under an allowed root.
CLAUDE_WEB_CWD=

# Your email address for reply-all self-exclusion and Slack self-filter.
CLAUDE_WEB_MY_EMAIL=

# Your Slack username for self-exclusion (defaults to the local-part of MY_EMAIL).
CLAUDE_WEB_MY_USERNAME=
